{
  "name": "cyberpunk-components-angular-lib",
  "version": "0.0.0",
  "scripts": {
    "start": "npm run build:lib && ng serve demo",
    "build:lib": "ng build chamfer-ui",
    "watch:lib": "ng build chamfer-ui --watch --configuration development",
    "build:demo": "ng build demo",
    "build": "npm run build:lib && npm run build:demo",
    "test": "ng test chamfer-ui",
    "pack:lib": "npm run build:lib && cd dist/chamfer-ui && npm pack"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}